# May be either the Django origin or the complete /api/v1 API root.
TEMPLEADDRESS_API_URL=http://127.0.0.1:8000
# Prefer this same-origin proxy; absolute Django origin and /api/v1 URLs also work.
NEXT_PUBLIC_API_URL=/api/backend
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# reCAPTCHA v2 checkbox site key; pair with USER_RECAPTCHA_PRIVATE_KEY on the backend.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# production (or unset) is indexable; any other value (staging, demo, development) adds noindex and blocks robots.
NEXT_PUBLIC_APP_ENV=development
# "true" exposes the Phase 2/3 demo portals that still use mock data. Keep false on production.
NEXT_PUBLIC_DEMO_PORTALS_ENABLED=false
# Header your ingress overwrites with the real client IP (for example x-real-ip). Leave empty if none exists;
# Django then skips its per-IP contact-reveal limit rather than counting every visitor as one IP.
TRUSTED_CLIENT_IP_HEADER=
# Same random value as SSR_API_KEY on Django, so page rendering is not rate limited. Server-only: never NEXT_PUBLIC.
SSR_API_KEY=
# App downloads: a direct HTTPS file/store URL, or /downloads/file.apk for a file in public/downloads/.
# Leave blank until the release is available; the corresponding button shows Coming soon.
ANDROID_APK_URL=
IOS_APP_STORE_URL=
# Compatible with old-code/landingpage-next: direct EAS .apk artifact URL (not its build details page).
# Used when ANDROID_APK_URL is blank.
NEXT_PUBLIC_ANDROID_APP_URL=
# proxy matches the old landing page's attachment response on a Node server.
# Amplify defaults this to redirect to bypass its 5.72 MB compute response limit.
ANDROID_APK_DOWNLOAD_MODE=proxy
